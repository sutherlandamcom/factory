# Base URL of the deployed site. Used by sites/starter to build canonical URLs
# and JSON-LD identifiers. Defaults to http://localhost:4321 when unset.
PUBLIC_SITE_URL=https://summitroofing.example.com

# Factory persistent control-plane database URL (PostgreSQL 18 compatible)
FACTORY_DATABASE_URL=postgresql://factory:password@localhost:5432/factory

# Factory test database URL used exclusively for persistence integration tests
FACTORY_TEST_DATABASE_URL=postgresql://factory:factory_test_password@localhost:5432/factory_test

# Search Intelligence structured SERP provider. Bright Data is the production
# default; set FACTORY_SERP_PROVIDER=dataforseo only to use the retained fallback.
FACTORY_SERP_PROVIDER=brightdata
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=factory_google_serp

# Optional retained DataForSEO fallback credentials.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Search reservations: trusted conservative per-call upper bounds in integer USD micros.
# Set only from the provider/request/token policy in use. Missing bounds block paid Search.
# FACTORY_SEARCH_SERP_MAX_COST_MICROS=
# FACTORY_SEARCH_GROUNDED_MAX_COST_MICROS=
# FACTORY_SEARCH_ANALYST_MAX_COST_MICROS=
