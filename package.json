{
  "name": "factory",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @factory/site-starter run dev",
    "build": "pnpm -r --if-present run build",
    "check": "pnpm -r --if-present run check",
    "test": "pnpm --filter @factory/site-starter run test",
    "qa": "pnpm run check && pnpm run build && pnpm run test",
    "factory": "pnpm --filter @factory/factory run start"
  }
}
