{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 3,
      "autodiscoverUrlBlocklist": ["http://localhost/404.html"]
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", {"minScore": 0.9}],
        "categories:seo": ["error", {"minScore": 0.95}],
        "categories:best-practices": ["error", {"minScore": 0.95}],
        "largest-contentful-paint": ["error", {"maxNumericValue": 2500}],
        "cumulative-layout-shift": ["error", {"maxNumericValue": 0.1}],
        "total-blocking-time": ["warn", {"maxNumericValue": 200}]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./qa-artifacts/lhci",
      "reportDescription": "Factory Run 9 LAB performance gates (representative production pages; TBT is the LAB responsiveness proxy — field INP is never claimed from this output)"
    }
  }
}
