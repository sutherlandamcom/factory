---
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  heading: string;
  items: FaqItem[];
}

const { heading, items } = Astro.props;
---

<section class="mx-auto max-w-5xl px-4 py-12">
  <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">{heading}</h2>
  <div class="mt-8 space-y-4">
    {
      items.map((item) => (
        <details class="rounded-lg border border-slate-200 bg-white p-5">
          <summary class="cursor-pointer font-medium text-slate-900">{item.question}</summary>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">{item.answer}</p>
        </details>
      ))
    }
  </div>
</section>
