---
interface Card {
  title: string;
  text: string;
}

interface Props {
  heading: string;
  cards: Card[];
}

const { heading, cards } = Astro.props;
---

<section class="mx-auto max-w-5xl px-4 py-12">
  <h2 class="font-display text-2xl font-semibold tracking-tight text-alpine-950 sm:text-3xl">{heading}</h2>
  <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      cards.map((card) => (
        <article class="rounded-sm border border-alpine-100 bg-white p-6">
          <h3 class="text-lg font-semibold text-alpine-950">{card.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-alpine-800">{card.text}</p>
        </article>
      ))
    }
  </div>
</section>
