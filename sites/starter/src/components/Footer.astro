---
interface Props {
  siteName: string;
}

const { siteName } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-slate-50">
  <div
    class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 px-4 py-8 text-sm text-slate-500"
  >
    <p>&copy; {year} {siteName}. All rights reserved.</p>
    <nav aria-label="Footer navigation">
      <ul class="flex gap-6">
        <li><a href="/" class="hover:text-slate-900">Home</a></li>
        <li><a href="/services/example" class="hover:text-slate-900">Services</a></li>
        <li><a href="/blog/example" class="hover:text-slate-900">Blog</a></li>
      </ul>
    </nav>
  </div>
</footer>
