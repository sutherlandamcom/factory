---
import type { SiteProfileNavigationEntry } from "@factory/contracts";

interface Props {
  siteName: string;
  navigation: SiteProfileNavigationEntry[];
  addressLines: string[];
}

const { siteName, navigation, addressLines } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-slate-50">
  <div
    class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 px-4 py-8 text-sm text-slate-500"
  >
    <div>
      <p>&copy; {year} {siteName}. All rights reserved.</p>
      {
        addressLines.length > 0 && (
          <p class="mt-1">
            {addressLines.map((line, index) => (
              <>
                {index > 0 && " · "}
                {line}
              </>
            ))}
          </p>
        )
      }
    </div>
    <nav aria-label="Footer navigation">
      <ul class="flex gap-6">
        {
          navigation.map((item) => (
            <li>
              <a href={item.targetSlug} class="hover:text-slate-900">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>
