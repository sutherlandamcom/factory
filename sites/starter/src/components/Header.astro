---
import type { SiteProfileNavigationEntry } from "@factory/contracts";

interface Props {
  siteName: string;
  navigation: SiteProfileNavigationEntry[];
}

const { siteName, navigation } = Astro.props;
---

<header class="border-b border-slate-line bg-paper">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-6 py-5">
    <a href="/" class="font-display text-lg font-semibold tracking-wide text-ink-900">{siteName}</a>
    <nav aria-label="Main navigation">
      <ul class="flex gap-6 text-sm tracking-wide text-ink-700">
        {
          navigation.map((item) => (
            <li>
              <a href={item.targetSlug} class="transition-colors hover:text-accent">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
