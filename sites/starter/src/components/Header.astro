---
import type { SiteProfileNavigationEntry } from "@factory/contracts";

interface Props {
  siteName: string;
  navigation: SiteProfileNavigationEntry[];
}

const { siteName, navigation } = Astro.props;
---

<header class="border-b border-slate-200 bg-white">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 px-4 py-4">
    <a href="/" class="text-lg font-bold text-slate-900">{siteName}</a>
    <nav aria-label="Main navigation">
      <ul class="flex gap-6 text-sm font-medium">
        {
          navigation.map((item) => (
            <li>
              <a href={item.targetSlug} class="text-slate-600 hover:text-slate-900">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
