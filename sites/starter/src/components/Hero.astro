---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  /** Rendered as the page's single H1. */
  heading: string;
  subheading: string;
  ctaText?: string;
  ctaHref?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}

const { heading, subheading, ctaText, ctaHref, image, imageAlt = "" } = Astro.props;
---

<section class="border-b border-alpine-100 bg-paper-100">
  <div class="mx-auto grid max-w-5xl items-center gap-10 px-4 py-16 md:grid-cols-2 md:py-20">
    <div>
      <h1 class="font-display text-4xl font-semibold tracking-tight text-alpine-950 sm:text-5xl">{heading}</h1>
      <p class="mt-5 text-lg leading-relaxed text-alpine-800">{subheading}</p>
      {
        ctaText && ctaHref && (
          <a
            href={ctaHref}
            class="mt-8 inline-block rounded-sm bg-alpine-900 px-6 py-3 text-sm font-medium text-paper-50 transition-colors hover:bg-alpine-800"
          >
            {ctaText}
          </a>
        )
      }
    </div>
    {
      image && (
        <Image
          src={image}
          alt={imageAlt}
          widths={[480, 768, 1024]}
          sizes="(max-width: 768px) 100vw, 50vw"
          class="rounded-sm"
          loading="eager"
        />
      )
    }
  </div>
</section>
