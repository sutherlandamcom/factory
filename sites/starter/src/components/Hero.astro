---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  /** Rendered as the page's single H1. */
  heading: string;
  subheading: string;
  ctaText?: string;
  ctaHref?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}

const { heading, subheading, ctaText, ctaHref, image, imageAlt = "" } = Astro.props;
---

<section class="bg-slate-50">
  <div class="mx-auto grid max-w-5xl items-center gap-10 px-4 py-16 md:grid-cols-2">
    <div>
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">{heading}</h1>
      <p class="mt-4 text-lg text-slate-600">{subheading}</p>
      {
        ctaText && ctaHref && (
          <a
            href={ctaHref}
            class="mt-8 inline-block rounded-md bg-sky-700 px-6 py-3 text-sm font-semibold text-white hover:bg-sky-800"
          >
            {ctaText}
          </a>
        )
      }
    </div>
    {
      image && (
        <Image
          src={image}
          alt={imageAlt}
          widths={[480, 768, 1024]}
          sizes="(max-width: 768px) 100vw, 50vw"
          class="rounded-lg"
          loading="eager"
        />
      )
    }
  </div>
</section>
