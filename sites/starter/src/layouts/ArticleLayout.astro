---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "./Layout.astro";

interface Props {
  title: string;
  description: string;
  /** ISO date string, e.g. "2026-01-15". */
  datePublished: string;
  author: string;
  image?: ImageMetadata;
  imageAlt?: string;
}

const { title, description, datePublished, author, image, imageAlt = "" } = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  datePublished,
  author: { "@type": "Organization", name: author },
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl.href },
};
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <article class="mx-auto max-w-3xl px-4 py-12">
    <header class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">{title}</h1>
      <p class="mt-3 text-sm text-slate-500">
        By {author} · <time datetime={datePublished}>{datePublished}</time>
      </p>
    </header>
    {
      image && (
        <Image
          src={image}
          alt={imageAlt}
          widths={[480, 768, 1200]}
          sizes="(max-width: 768px) 100vw, 768px"
          class="mb-8 rounded-lg"
        />
      )
    }
    <div class="space-y-6 leading-relaxed text-slate-700">
      <slot />
    </div>
  </article>
</Layout>
