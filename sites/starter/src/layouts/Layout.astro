---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { siteProfile } from "../lib/site-profile";
import type { SiteProfileNavigationEntry } from "@factory/contracts";

interface Props {
  /** Page title without the site-name suffix. */
  title: string;
  description: string;
  /** Optional JSON-LD object, rendered as application/ld+json. */
  jsonLd?: Record<string, unknown>;
}

const { title, description, jsonLd } = Astro.props;

const fullTitle = `${title} | ${siteProfile.siteName}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang={siteProfile.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl.href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="flex min-h-screen flex-col bg-paper-50 font-sans text-alpine-950 antialiased">
    <Header siteName={siteProfile.siteName} navigation={siteProfile.navigation satisfies SiteProfileNavigationEntry[]} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer
      siteName={siteProfile.siteName}
      navigation={siteProfile.navigation satisfies SiteProfileNavigationEntry[]}
      addressLines={siteProfile.addressLines ?? []}
    />
  </body>
</html>
