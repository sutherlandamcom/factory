---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page Not Found"
  description="The page you requested could not be found."
>
  <section class="mx-auto max-w-5xl px-4 py-24 text-center">
    <h1 class="font-display text-5xl font-semibold tracking-tight text-alpine-950">404</h1>
    <p class="mt-4 text-lg text-alpine-800">
      Sorry, the page you were looking for doesn't exist or has moved.
    </p>
    <a
      href="/"
      class="mt-8 inline-block rounded-sm bg-alpine-900 px-6 py-3 text-sm font-medium text-paper-50 hover:bg-alpine-800"
    >
      Back to homepage
    </a>
  </section>
</Layout>
