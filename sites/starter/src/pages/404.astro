---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page Not Found"
  description="The page you requested could not be found."
>
  <section class="mx-auto max-w-5xl px-6 py-24 text-center">
    <h1 class="font-display text-5xl font-bold tracking-tight text-ink-900">404</h1>
    <p class="mt-4 text-lg text-ink-500">
      Sorry, the page you were looking for doesn't exist or has moved.
    </p>
    <a
      href="/"
      class="mt-8 inline-block rounded-md bg-accent px-6 py-3 text-sm font-semibold text-paper-raised transition-colors hover:bg-accent-deep"
    >
      Back to homepage
    </a>
  </section>
</Layout>
