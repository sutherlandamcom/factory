---
import Layout from "../layouts/Layout.astro";
import EditorialBand from "../components/EditorialBand.astro";
import DefinitionList from "../components/DefinitionList.astro";
import FAQ from "../components/FAQ.astro";
import { siteProfile } from "../lib/site-profile";

const title = "Independent advice for consequential French Alps property decisions";
const description =
  "Evidence-led acquisition and asset advisory for international buyers considering consequential property decisions in Chamonix and Megève.";

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: siteProfile.siteName,
  description,
  url: canonicalUrl,
};

const pathways = [
  {
    term: "Property Acquisition Advisory",
    description:
      "Supports strategy and sequencing before or during a search — the decision of how and when to proceed, producing a structured acquisition plan.",
  },
  {
    term: "Asset Review",
    description:
      "Addresses a specific property through structured evidence and risk review — the decision of whether a particular asset warrants commitment, producing a documented assessment.",
  },
  {
    term: "Private Office Advisory",
    description:
      "Intended for complex coordination needs, where a property decision sits inside a wider set of arrangements that must be held together over time.",
  },
  {
    term: "Investment Memorandum",
    description:
      "A supplied concept for a structured decision document that would record the evidence and reasoning behind a decision. It is presented here as a concept in development rather than an operational product, and its eventual form will be defined before any engagement relies on it.",
  },
];

const faqItems = [
  {
    question: "Is Sutherland Private Office an estate agency or a transaction intermediary?",
    answer:
      "No. Real-estate intermediation in France is a regulated activity, and permissions must be verified before any transaction-related role can be described. This launch presents independent advisory and decision support only; the firm does not act as an estate agent, broker or transaction intermediary, and it does not present property inventory.",
  },
  {
    question: "Does the seller's diagnostic dossier settle the technical questions?",
    answer:
      "The diagnostic dossier is an important input to any review, and a careful reading of it informs a property-specific assessment. It is, however, prepared on the seller's side and does not replace a broader buyer-side technical assessment of the asset.",
  },
  {
    question: "Can market-level evidence tell me what a specific property is worth?",
    answer:
      "No. Transaction records and resort-level figures establish context, but market-level evidence cannot determine the value, condition or suitability of an individual asset. That judgement requires a property-specific review of the asset itself.",
  },
  {
    question: "How does an engagement begin?",
    answer:
      "With a defined decision and a selective scoping conversation, consistent with discreet private-office engagements. The firm reviews each situation before confirming whether it can usefully help.",
  },
];
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  {/* Hero — asymmetric two-column first viewport on paper, no button, no image. */}
  <section class="bg-paper">
    <div
      class="mx-auto grid max-w-6xl gap-12 px-6 py-20 md:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] md:gap-16 md:py-28"
    >
      <div>
        <p class="text-xs font-semibold tracking-[0.18em] uppercase text-accent">
          Decision support before commitment
        </p>
        <h1
          class="mt-4 font-display text-4xl font-semibold tracking-tight text-ink-900 md:text-6xl"
        >
          {title}
        </h1>
        <p class="mt-8 max-w-xl text-lg leading-relaxed text-ink-700">
          <a href="/" class="text-accent-deep underline decoration-slate-line underline-offset-4 hover:decoration-accent">Sutherland Private Office</a>
          is a real-estate investment advisory and Private Office focused on the French Alps. It
          provides evidence-led analysis and decision support to international buyers weighing
          consequential property decisions in Chamonix and Megève.
        </p>
      </div>
      <div class="border-l border-slate-line pl-8 md:self-center">
        <dl class="space-y-6 text-base leading-relaxed">
          <div>
            <dt class="text-xs font-semibold tracking-[0.18em] uppercase text-ink-500">What it is</dt>
            <dd class="mt-1 text-ink-700">
              An independent real-estate investment advisory and Private Office for the French Alps.
            </dd>
          </div>
          <div>
            <dt class="text-xs font-semibold tracking-[0.18em] uppercase text-ink-500">
              What it is not
            </dt>
            <dd class="mt-1 text-ink-700">
              Not an estate agency, not a broker, and not a source of property inventory. The
              launch is separate from any future transactional arm.
            </dd>
          </div>
          <div>
            <dt class="text-xs font-semibold tracking-[0.18em] uppercase text-ink-500">
              Where it works
            </dt>
            <dd class="mt-1 text-ink-700">
              Chamonix and Megève are the priority markets.
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  {/* Positioning statement — airy single-column band on mist. */}
  <EditorialBand eyebrow="The boundary" heading="Analysis rather than inventory" variant="airy" tone="mist">
    <p>
      A buyer researching the French Alps quickly finds that sale-oriented searches are dominated by
      agents, portals and listing pages — material produced to sell property.
    </p>
    <p class="mt-4">
      Market-level evidence cannot determine the value, condition or suitability of an individual
      asset. A resort average does not price a specific chalet, and a market overview does not
      examine a specific building.
    </p>
    <p class="mt-4">
      The firm's position is analysis and decision support on the buyer's side, not intermediation.
    </p>
  </EditorialBand>

  {/* Service pathways — narrow dense band on paper, definition list rather than cards. */}
  <section class="bg-paper py-12 md:py-16">
    <div class="mx-auto max-w-4xl px-6">
      <h2 class="font-display text-3xl font-semibold tracking-tight text-ink-900 md:text-4xl">
        Choose the support appropriate to the decision
      </h2>
      <div class="mt-8">
        <DefinitionList entries={pathways} />
      </div>
      <p class="mt-6 text-base leading-relaxed text-ink-700">
        The two established pathways, Property Acquisition Advisory and Asset Review, are the
        starting points for most engagements.
      </p>
    </div>
  </section>

  {/* Evidence band — dense two columns on mist: what the sources tell you vs what they cannot. */}
  <section class="bg-mist py-12 md:py-16">
    <div class="mx-auto max-w-6xl px-6">
      <p class="text-xs font-semibold tracking-[0.18em] uppercase text-accent">
        Evidence and its limits
      </p>
      <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-ink-900 md:text-4xl">
        What the evidence can and cannot tell you
      </h2>
      <div class="mt-8 grid gap-10 md:grid-cols-2 md:gap-16">
        <div>
          <h3 class="font-display text-xl font-semibold text-ink-900">What the sources tell you</h3>
          <p class="mt-4 text-base leading-relaxed text-ink-700">
            Official transaction, diagnostic and risk sources can inform a property-specific review
            when carefully interpreted. Asking-price transparency from official transaction records
            sets the negotiating context. The seller-side diagnostic dossier documents what has been
            measured about the property. Natural-risk registers record the hazards officially
            recognised at the address.
          </p>
        </div>
        <div>
          <h3 class="font-display text-xl font-semibold text-ink-900">What they cannot tell you</h3>
          <p class="mt-4 text-base leading-relaxed text-ink-700">
            None of these sources determines the value, condition or suitability of an individual
            asset. Resort-level figures describe a market, not a building; a diagnostic dossier is
            prepared for the seller's obligations, not the buyer's questions. Interpreting them for
            a specific property is the work of a review — it does not replace legal, notarial or
            technical due diligence.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* FAQ — wide band on paper, details/summary keeps it scannable. */}
  <div class="bg-paper py-8 md:py-12">
    <FAQ heading="Understanding the advisory scope" items={faqItems} />
  </div>

  {/* Closing statement — airy mist band, prose only, no conversion element. */}
  <section class="bg-mist py-16 md:py-24">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <h2 class="font-display text-3xl font-semibold tracking-tight text-ink-900 md:text-4xl">
        Bring the asset and the decision context
      </h2>
      <p class="mt-6 font-display text-xl leading-relaxed text-ink-700 md:text-2xl">
        An engagement begins with a defined decision and a selective scoping conversation. The firm
        reviews each situation before accepting it. That is the whole of the commitment at the
        start: a clear question, examined carefully.
      </p>
    </div>
  </section>
</Layout>
