---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import ContentSection from "../components/ContentSection.astro";
import FAQ from "../components/FAQ.astro";
import { siteProfile } from "../lib/site-profile";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: siteProfile.siteName,
  description: "Independent, evidence-led advisory for consequential French Alps property decisions.",
  url: new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href,
};
---

<Layout
  title="Independent advice for consequential French Alps property decisions"
  description="Sutherland Private Office is an independent, evidence-led advisory for high-value French Alps property decisions, prioritising Chamonix and Megève."
  jsonLd={jsonLd}
>
  <Hero
    heading="Independent advice for consequential French Alps property decisions"
    subheading="Sutherland Private Office is an independent, evidence-led advisory for high-value property decisions in the French Alps, prioritising Chamonix and Megève."
  />

  <ContentSection heading="Evidence-led market intelligence">
    <p>
      The site publishes dated, source-backed market intelligence for the two priority
      markets — Chamonix and Megève — along with preparation guidance for non-resident
      buyers of French property.
    </p>
    <ul class="list-disc space-y-2 pl-5">
      <li><a class="text-accent-700 underline underline-offset-2 hover:text-accent-800" href="/chamonix-market-intelligence">Chamonix market intelligence</a></li>
      <li><a class="text-accent-700 underline underline-offset-2 hover:text-accent-800" href="/megeve-market-intelligence">Megève market intelligence</a></li>
      <li><a class="text-accent-700 underline underline-offset-2 hover:text-accent-800" href="/blog/non-resident-french-property-readiness">Non-resident French property readiness</a></li>
    </ul>
  </ContentSection>
</Layout>
