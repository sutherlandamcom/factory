---
import Layout from "../layouts/Layout.astro";
import { siteProfile } from "../lib/site-profile";

/**
 * TEMPORARY trusted-foundation scaffold — replaced by the Factory page worker
 * in the same workflow run (Phase G). Exists only so the shell commit builds.
 * Not a production candidate; QA assertions for the final homepage are the
 * dynamic task QA spec, not this file's content.
 */

const title = "Independent advisory for French Alps property decisions";
const description =
  "Evidence-led acquisition and asset advisory for international buyers making consequential property decisions in Chamonix and Megève.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: siteProfile.siteName,
  description,
  url: new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href,
};
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <section class="bg-paper">
    <div class="mx-auto max-w-6xl px-6 py-24">
      <h1 class="font-display text-4xl font-semibold tracking-tight text-ink-900 md:text-6xl">{title}</h1>
      <p class="mt-6 max-w-2xl text-lg text-ink-700">{description}</p>
    </div>
  </section>
</Layout>
