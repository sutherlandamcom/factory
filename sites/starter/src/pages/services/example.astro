---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import ContentSection from "../../components/ContentSection.astro";
import FeatureCards from "../../components/FeatureCards.astro";
import CTA from "../../components/CTA.astro";
import repairImage from "../../assets/roof-repair.png";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: "Roof repair and replacement",
  provider: { "@type": "LocalBusiness", name: "Summit Roofing Co." },
  areaServed: "Boulder, CO",
  url: new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href,
};
---

<Layout
  title="Roof Repair & Replacement Services"
  description="Roof repair, full replacement, and storm damage restoration for Boulder-area homes. Free inspections, transparent pricing, and a 10-year workmanship warranty."
  jsonLd={jsonLd}
>
  <Hero
    heading="Roof repair & replacement"
    subheading="From emergency leak repair to full tear-offs, our licensed crews handle every roofing job with transparent pricing and a written warranty."
    ctaText="Back to homepage"
    ctaHref="/"
    image={repairImage}
    imageAlt="A Summit Roofing crew member replacing damaged shingles"
  />

  <FeatureCards
    heading="What we do"
    cards={[
      {
        title: "Leak & shingle repair",
        text: "Targeted repairs for missing shingles, failed flashing, and active leaks — usually scheduled within a week.",
      },
      {
        title: "Full roof replacement",
        text: "Complete tear-off and replacement with architectural shingles, metal, or tile, most homes done in one to two days.",
      },
      {
        title: "Storm damage restoration",
        text: "Hail and wind damage assessment with full documentation for your insurance claim, from inspection to final walkthrough.",
      },
    ]}
  />

  <ContentSection heading="How a project works">
    <p>
      Every project starts with a free inspection and a written, fixed-price quote. Once you
      approve, we order materials, pull permits, and schedule your crew. You get a single point of
      contact from the first ladder to the final magnetic nail sweep.
    </p>
    <p>
      Not sure whether you need a repair or a replacement? Our article on{" "}
      <a href="/blog/example" class="font-medium text-sky-700 hover:underline"
        >the 5 warning signs of roof damage</a
      >{" "}
      walks through what we look for during an inspection.
    </p>
  </ContentSection>

  <CTA
    heading="Ready for a fixed-price quote?"
    text="Schedule a free inspection and we'll give you a written quote good for 30 days."
    buttonText="Start at our homepage"
    buttonHref="/"
  />
</Layout>
